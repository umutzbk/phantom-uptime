# Secrets. The template is committed, the filled-in file never is.
.env
.env.local
!.env.production.example

# Generated: the simulator makes raw/, build_marts.py makes marts/. Both are
# reproducible from the scripts, and marts/ is 130 MB.
raw/
marts/
dist/

# Captured live traces. demo_traces/ holds the committed set that replay needs.
traces/*.json
!demo_traces/

# Working directories, not part of the project.
_out_of_scope/
scratch/
backups/
integrity-runs/

__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
