# Copy to .env on the server and fill in. Never commit the filled-in version.
#
#   cp .env.production.example .env
#   nano .env
#   docker compose up -d --build
#
# Every value here is read by docker-compose.yml and passed to the containers.
# Nothing in this file is ever sent to the browser.

# ---------------------------------------------------------------- the gate
# Anyone who finds the URL sees a login screen and nothing else. Leave both
# blank and the gate is off, which is only appropriate on a laptop.
DEMO_USER=changeme
DEMO_PASSWORD=change-this-to-something-long

# Signs the session cookie. Generate a fresh one and keep it secret:
#   openssl rand -hex 32
SESSION_SECRET=

# 1 once the site is on https, which it will be behind Caddy. Set to 0 only for
# a plain-http test, otherwise the browser will refuse to store the cookie.
COOKIE_SECURE=1

# ---------------------------------------------------------------- the model
# Live mode only. With this blank the app still runs: it serves the recorded
# investigations, and says so on screen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# replay | live. Replay is the safe default for a public URL: it costs nothing
# and it cannot fail in front of an audience.
COPILOT_MODE=replay
APP_MODE=production

# ---------------------------------------------------------------- semantic layer
# Cube is reached over the compose network, so it is not published and this is
# already correct in docker-compose.yml. Left here because it is the one piece
# of wiring worth being able to see.
# CUBE_URL=http://cube:4000/cubejs-api/v1
CUBEJS_API_SECRET=generate-another-random-string
CUBEJS_DEV_MODE=false
CUBEJS_LOG_LEVEL=warn

# ---------------------------------------------------------------- addresses
# The hostname Caddy should answer on and fetch a certificate for. With an
# Elastic IP of 203.0.113.10 that is 203-0-113-10.sslip.io, which resolves to that
# address without owning a domain. Use :80 for a plain-http test.
SITE_ADDRESS=

# Only if a frontend is hosted somewhere else, for example on Vercel. Exact
# origins, comma separated, no trailing slash. Leave blank for the single-link
# deployment, which is same-origin and needs no CORS at all.
CORS_ORIGINS=
