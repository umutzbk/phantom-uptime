# Copy to .env and fill in. Never commit .env.
# Server-side only - none of these are exposed to the browser.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

CUBEJS_API_SECRET=change-me-locally
CUBE_URL=http://localhost:4000/cubejs-api/v1

# Set to replay to force captured-trace mode even when a key is present
COPILOT_MODE=live
